-- Every GUI made by these scripts, wherever it lives
local function collectGuis()
	local list, seen = {}, {}
	local function add(inst)
		if inst:IsA("ScreenGui") and not seen[inst] then
			seen[inst] = true
			list[#list + 1] = inst
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do add(inst) end

	local function scan(container)
		if not container then return end
		local ok, children = pcall(function() return container:GetChildren() end)
		if not ok then return end
		for _, child in ipairs(children) do
			if child:IsA("ScreenGui") and child:GetAttribute(TAG) then add(child) end
		end
	end
	scan(playerGui)
	pcall(function() scan(game:GetService("CoreGui")) end)
	if gethui then pcall(function() scan(gethui()) end) end
	return list
end

-- One GUI per flag: running again with the same flag replaces the old one
for _, old in ipairs(collectGuis()) do
	if old:GetAttribute("Flag") == FLAG then
		old:Destroy()
	end
end

-- Random 20-character name, different for every GUI
local CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789*^%/?#$"
local rng = Random.new()

local function randomName(length)
	local out = {}
	for i = 1, length do
		local n = rng:NextInteger(1, #CHARS)
		out[i] = CHARS:sub(n, n)
	end
	return table.concat(out)
end

local function tween(obj, time, props, style, direction)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function make(class, props, parent)
	local inst = Instance.new(class)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function p2(input)
	return Vector2.new(input.Position.X, input.Position.Y)
end

local function run(fn)
	task.spawn(function()
		local ok, err = pcall(fn)
		if not ok then warn(err) end
	end)
end

-- Highest place available: hidden UI container > CoreGui > PlayerGui
local function parentGui(gui)
	local targets = {}
	if gethui then
		local ok, container = pcall(gethui)
		if ok and container then targets[#targets + 1] = container end
	end
	local okCore, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCore and coreGui then targets[#targets + 1] = coreGui end
	targets[#targets + 1] = playerGui

	for _, target in ipairs(targets) do
		local ok = pcall(function() gui.Parent = target end)
		if ok and gui.Parent == target then return end
	end
end

