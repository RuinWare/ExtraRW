local function viewport()
	local size = screenGui.AbsoluteSize
	if size.X < 1 or size.Y < 1 then
		size = workspace.CurrentCamera.ViewportSize
	end
	return size
end

-- Off-screen protection (the drag bar below the box is counted too)
local function fitSize(size)
	local v = viewport()
	return Vector2.new(
		math.min(size.X, v.X - SCREEN_MARGIN * 2),
		math.min(size.Y, v.Y - SCREEN_MARGIN * 2 - BAR_BELOW)
	)
end

local function clampCenter(center, size)
	local v = viewport()
	local half = size / 2
	local minX, minY = half.X + SCREEN_MARGIN, half.Y + SCREEN_MARGIN
	local maxX = v.X - half.X - SCREEN_MARGIN
	local maxY = v.Y - half.Y - SCREEN_MARGIN - BAR_BELOW
	return Vector2.new(
		math.clamp(center.X, minX, math.max(minX, maxX)),
		math.clamp(center.Y, minY, math.max(minY, maxY))
	)
end

-- Corner roundness: scales with the box, but never past MAX_CORNER pixels
local function cornerFor(size)
	return math.floor(math.min(CORNER * math.min(size.X, size.Y), MAX_CORNER) + 0.5)
end

