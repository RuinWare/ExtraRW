local connections = {}

local mode = "default" -- "default", "pill" or "circle"
local dragging, resizing = false, false
local activeInput, inputStart
local dragOrigin, resizeOriginSize, resizeTopLeft

-- Size limits for the pill and circle shapes
local pillMinWidth = math.max(MIN_SIZE.X, PILL_HEIGHT * 1.25)
local circleMin = math.max(MIN_SIZE.X, MIN_SIZE.Y)
local circleMax = math.min(MAX_SIZE.X, MAX_SIZE.Y)

local sizeTarget = startSize
local posTarget = startCenter
local sizeCur, posCur = startSize, startCenter
local cornerCur = cornerFor(startSize, "default")
local lastCorner = -1
local lastInset = -1
local morphUntil = 0

-- Each shape remembers its own size, so switching back and forth feels natural
local circleStart = math.clamp((startSize.X + startSize.Y) / 2, circleMin, circleMax)
local modeSizes = {
	default = startSize,
	pill = Vector2.new(math.clamp(startSize.X, pillMinWidth, MAX_SIZE.X), PILL_HEIGHT),
	circle = Vector2.new(circleStart, circleStart),
}

connections[#connections + 1] = RunService.RenderStepped:Connect(function(dt)
	-- off-screen protection every frame (and the shape rules)
	sizeTarget = fitSize(sizeTarget)
	if mode == "circle" then
		local side = math.min(sizeTarget.X, sizeTarget.Y)
		sizeTarget = Vector2.new(side, side)
	elseif mode == "pill" then
		sizeTarget = Vector2.new(sizeTarget.X, math.min(sizeTarget.Y, PILL_HEIGHT))
	end
	posTarget = clampCenter(posTarget, sizeTarget)

	-- slower follow while dragging = the box trails behind the bar, shape changes ease in gently
	local speed = DRAG_FOLLOW_SPEED
	if resizing then
		speed = RESIZE_FOLLOW_SPEED
	elseif os.clock() < morphUntil then
		speed = MORPH_FOLLOW_SPEED
	end
	local alpha = 1 - math.exp(-dt * speed)
	sizeCur = fitSize(sizeCur:Lerp(sizeTarget, alpha))
	posCur = clampCenter(posCur:Lerp(posTarget, alpha), sizeCur)

	holder.Size = UDim2.fromOffset(math.floor(sizeCur.X + 0.5), math.floor(sizeCur.Y + 0.5))
	holder.Position = UDim2.fromOffset(math.floor(posCur.X + 0.5), math.floor(posCur.Y + 0.5))

	-- the corners ease toward the roundness of the current shape
	cornerCur += (cornerFor(sizeCur, mode) - cornerCur) * (1 - math.exp(-dt * CORNER_SPEED))
	local corner = math.floor(cornerCur + 0.5)
	if corner ~= lastCorner then
		lastCorner = corner
		boxCorner.CornerRadius = UDim.new(0, corner)
	end

	-- the corner icons follow the rounded edge, so they always stay inside the shape
	local inset = math.max(ICON_INSET, 0.293 * cornerCur + 1)
	if math.abs(inset - lastInset) > 0.05 then
		lastInset = inset
		local extra = inset - ICON_INSET
		handle.Position = UDim2.new(1, -extra, 1, -extra)
		local c = inset + 9
		collapseHit.Position = UDim2.new(0, c, 0, c)
	end
end)

