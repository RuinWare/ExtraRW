-- Cycle button (top-left): a circle with two arrows. Tapping it cycles the shape
-- default > pill > circle, and the icon spins every time it switches
local collapseHit = make("TextButton", {
	Name = "CycleHit",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0, 21, 0, 21),
	Size = UDim2.fromOffset(CYCLE_HIT, CYCLE_HIT),
	BackgroundTransparency = 1,
	Text = "",
