-- 9-slice the glow using the image's real size: the corners and soft edges stay a
-- constant size and only the middle stretches, so resizing never distorts it.
task.spawn(function()
	local deadline = os.clock() + 5
	while glow.Parent and os.clock() < deadline do
		local ok, size = pcall(function() return glow.ContentImageSize end)
		if not ok then return end -- older client: keep the plain stretch
		if size.X > 0 and size.Y > 0 then
			local sx, sy = size.X * GLOW_SLICE, size.Y * GLOW_SLICE
			glow.SliceCenter = Rect.new(sx, sy, size.X - sx, size.Y - sy)
			glow.SliceScale = math.max(GLOW_SPREAD, 1) / sx
			glow.ScaleType = Enum.ScaleType.Slice
			return
		end
		task.wait(0.05)
	end
end)

