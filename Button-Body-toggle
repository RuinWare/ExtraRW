end)
dragHit.MouseEnter:Connect(function()
	if not dragging then tween(bar, 0.2, { BackgroundTransparency = 0.3 }) end
end)
dragHit.MouseLeave:Connect(function()
	if not dragging then tween(bar, 0.25, { BackgroundTransparency = BAR_IDLE }) end
end)

-- Resize (default and circle shapes): only while holding the corner handle
handle.InputBegan:Connect(function(input)
	if not isPress(input) or dragging or resizing or mode == "pill" then return end
	resizing = true
	activeInput = input
	inputStart = p2(input)
	resizeOriginSize = sizeTarget
	resizeTopLeft = posTarget - sizeTarget / 2
	tween(iconGroup, 0.2, { GroupTransparency = 0.05 })
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			resizing = false
			if mode ~= "pill" then tween(iconGroup, 0.3, { GroupTransparency = ICON_IDLE }) end
		end
	end)
end)
handle.MouseEnter:Connect(function()
	if not resizing and mode ~= "pill" then tween(iconGroup, 0.2, { GroupTransparency = 0.2 }) end
end)
handle.MouseLeave:Connect(function()
	if not resizing and mode ~= "pill" then tween(iconGroup, 0.25, { GroupTransparency = ICON_IDLE }) end
end)

-- Resize (pill shape): only the length, by holding the vertical bar
pillHandle.InputBegan:Connect(function(input)
	if not isPress(input) or dragging or resizing or mode ~= "pill" then return end
	resizing = true
	activeInput = input
	inputStart = p2(input)
	resizeOriginSize = sizeTarget
	resizeTopLeft = posTarget - sizeTarget / 2
	tween(pillBar, 0.2, { BackgroundTransparency = 0.15, Size = PILL_BAR_SIZE_ACTIVE })
	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			resizing = false
			if mode == "pill" then tween(pillBar, 0.3, { BackgroundTransparency = BAR_IDLE, Size = PILL_BAR_SIZE }) end
		end
	end)
end)
pillHandle.MouseEnter:Connect(function()
	if not resizing and mode == "pill" then tween(pillBar, 0.2, { BackgroundTransparency = 0.3 }) end
end)
pillHandle.MouseLeave:Connect(function()
	if not resizing and mode == "pill" then tween(pillBar, 0.25, { BackgroundTransparency = BAR_IDLE }) end
end)

connections[#connections + 1] = UserInputService.InputChanged:Connect(function(input)
	if not (dragging or resizing) then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= activeInput then return end

	local delta = p2(input) - inputStart
	if dragging then
		posTarget = clampCenter(dragOrigin + delta, sizeTarget)
	else
		local v = viewport()
		local newSize
		if mode == "pill" then
			-- only the length changes, the height stays locked
			newSize = Vector2.new(math.clamp(resizeOriginSize.X + delta.X, pillMinWidth, MAX_SIZE.X), PILL_HEIGHT)
		elseif mode == "circle" then
			-- x and y always stay the same size
			local side = math.clamp(resizeOriginSize.X + (delta.X + delta.Y) / 2, circleMin, circleMax)
			newSize = Vector2.new(side, side)
		else
			newSize = Vector2.new(
				math.clamp(resizeOriginSize.X + delta.X, MIN_SIZE.X, MAX_SIZE.X),
				math.clamp(resizeOriginSize.Y + delta.Y, MIN_SIZE.Y, MAX_SIZE.Y)
			)
		end
		-- never grow past the edge of the screen
		newSize = Vector2.new(
			math.min(newSize.X, v.X - SCREEN_MARGIN - resizeTopLeft.X),
			math.min(newSize.Y, v.Y - SCREEN_MARGIN - BAR_BELOW - resizeTopLeft.Y)
		)
		if mode == "circle" then
			local side = math.min(newSize.X, newSize.Y)
			newSize = Vector2.new(side, side)
		end
		sizeTarget = newSize
		posTarget = resizeTopLeft + newSize / 2 -- top-left corner stays put
	end
end)

-- Shape name: sits on top of the title and shows for a moment when the shape changes
local modeLabel = make("TextLabel", {
	Name = "ModeLabel",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = label.Position,
	Size = label.Size,
	BackgroundTransparency = 1,
	Text = "",
	TextColor3 = WHITE,
	TextTransparency = 1,
	TextSize = TEXT_SIZE,
	TextScaled = false,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Center,
	TextYAlignment = Enum.TextYAlignment.Center,
	FontFace = FONT,
	ZIndex = 2,
}, box)

local flashToken = 0
local function flashModeName(name)
	flashToken += 1
	local token = flashToken
	modeLabel.Text = name

	-- quick crossfade: the title fades out while the shape name fades in
	tween(label, 0.2, { TextTransparency = 1 }, Enum.EasingStyle.Quad)
	tween(modeLabel, 0.2, { TextTransparency = TEXT_TRANSPARENCY }, Enum.EasingStyle.Quad)

	-- after a moment it fades out into the normal title
	task.delay(0.2 + MODE_TEXT_TIME, function()
		if token ~= flashToken or not screenGui.Parent then return end
		tween(modeLabel, 0.4, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
		tween(label, 0.4, { TextTransparency = TEXT_TRANSPARENCY }, Enum.EasingStyle.Sine)
	end)
end

-- Shapes: the cycle button goes default > pill > circle > default
local MODES = { "default", "pill", "circle" }

local function setMode(newMode)
	if newMode == mode or dragging or resizing then return end
	modeSizes[mode] = sizeTarget -- remember the shape we're leaving
	mode = newMode
	sizeTarget = fitSize(modeSizes[newMode])
	morphUntil = os.clock() + 0.8

	-- the old resize icon fades out, the new one fades in
	local isPill = newMode == "pill"
	handle.Interactable = not isPill
	pillHandle.Interactable = isPill
	tween(iconGroup, 0.35, { GroupTransparency = isPill and 1 or ICON_IDLE }, Enum.EasingStyle.Quad)
	tween(pillBar, 0.4, { BackgroundTransparency = isPill and BAR_IDLE or 1 }, Enum.EasingStyle.Quad)

	-- the text glides to the right height for the new shape
	local nudge = TEXT_NUDGE_Y
	if isPill then nudge = PILL_TEXT_NUDGE_Y elseif newMode == "circle" then nudge = CIRCLE_TEXT_NUDGE_Y end
	local textPosition = UDim2.new(0.5, 0, 0.5, nudge)
	tween(label, 0.45, { Position = textPosition })
	tween(modeLabel, 0.45, { Position = textPosition })

	flashModeName(MODE_NAMES[newMode] or newMode)
end

local spin = 0
collapseHit.Activated:Connect(function()
	local before = mode
	setMode(MODES[(table.find(MODES, mode) or 1) % #MODES + 1])
	if mode == before then return end -- it didn't switch (busy dragging or resizing)

	-- spin once, smoothly, every time the shape switches
	spin += 360
	tween(cycleIcon, 0.7, { Rotation = spin }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
end)
collapseHit.MouseEnter:Connect(function()
	tween(cycleIcon, 0.2, { GroupTransparency = 0.2 })
end)
collapseHit.MouseLeave:Connect(function()
	tween(cycleIcon, 0.25, { GroupTransparency = CYCLE_IDLE })
end)

----------------------------------------------------------------
-- Click: press animation, on/off state, glow, run ON / OFF code
----------------------------------------------------------------
local isOn = false
local stateToken = 0

local function setState(on)
	isOn = on
	stateToken += 1
	local token = stateToken

	tween(box, 0.25, { BackgroundColor3 = on and BG_ON or BG_COLOR })
	tween(stroke, 0.25, { Transparency = on and 0.3 or STROKE_IDLE, Thickness = on and 2 or 1 })

	if on then
		-- bright flash, then settle into a steady glow
		setGlow(1, 0.08, Enum.EasingStyle.Quad)
		task.delay(0.1, function()
			if token ~= stateToken or not screenGui.Parent then return end
			setGlow(0.55, 0.3, Enum.EasingStyle.Sine)
		end)
	else
		setGlow(0, 0.25, Enum.EasingStyle.Sine)
	end
end

body.InputBegan:Connect(function(input)
	if isPress(input) then tween(popScale, 0.12, { Scale = 0.96 }) end
end)
body.InputEnded:Connect(function(input)
	if isPress(input) then tween(popScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back) end
end)
body.MouseEnter:Connect(function()
	tween(box, 0.25, { BackgroundColor3 = isOn and BG_ON:Lerp(WHITE, 0.06) or BG_HOVER })
end)
body.MouseLeave:Connect(function()
	tween(box, 0.3, { BackgroundColor3 = isOn and BG_ON or BG_COLOR })
	tween(popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end)

body.Activated:Connect(function()
	local nextState = not isOn
	setState(nextState)
	run(nextState and OnCode or OffCode)
end)

