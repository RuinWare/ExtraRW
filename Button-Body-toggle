local cycleIcon = make("CanvasGroup", {
	Name = "CycleIcon",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(CYCLE_BOX, CYCLE_BOX),
	BackgroundTransparency = 1,
	GroupTransparency = 1,
	ZIndex = 5,
}, collapseHit)
do
	local center = CYCLE_BOX / 2
	local wing = 5              -- length of each arrow-head line
	local sweep = math.rad(120) -- how much of the circle each arrow covers
	local steps = math.max(8, math.ceil((CYCLE_R * sweep) / (CYCLE_THICK / 3)))

	local function roundPart(position, size, rotation)
		local part = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(position.X, position.Y),
			Size = UDim2.fromOffset(size.X, size.Y),
			Rotation = rotation,
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, cycleIcon)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, part)
	end

	for _, startAngle in ipairs({ 0, math.pi }) do
		-- the arc, drawn with round dots
		for i = 0, steps do
			local angle = startAngle + sweep * (i / steps)
			roundPart(
				Vector2.new(center + CYCLE_R * math.cos(angle), center + CYCLE_R * math.sin(angle)),
				Vector2.new(CYCLE_THICK, CYCLE_THICK),
				0
			)
		end

		-- the arrow head at the end of the arc (two short lines meeting at the tip)
		local endAngle = startAngle + sweep
		local tip = Vector2.new(center + CYCLE_R * math.cos(endAngle), center + CYCLE_R * math.sin(endAngle))
		local back = Vector2.new(math.sin(endAngle), -math.cos(endAngle)) -- back along the arc
		for _, spread in ipairs({ math.rad(40), -math.rad(40) }) do
			local cosS, sinS = math.cos(spread), math.sin(spread)
			local dir = Vector2.new(back.X * cosS - back.Y * sinS, back.X * sinS + back.Y * cosS)
			roundPart(tip + dir * (wing / 2), Vector2.new(wing, CYCLE_THICK), math.deg(math.atan2(dir.Y, dir.X)))
		end
	end
end

