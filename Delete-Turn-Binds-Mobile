-- LocalScript: DeleteGuiByFlag
-- Deletes ONE button / toggle / hold button: the one whose FLAG matches the flag set below.
-- A toggle that is ON (or a hold button being held) runs its OFF code first.
-- (To remove all of them at once, use DestroyAllGuis instead.)

-- ============================================================
-- FLAG
-- ============================================================
-- The FLAG of the button, toggle or hold button you want to delete (exact match).
local FLAG = "lfth"

-- ============================================================
-- DO NOT EDIT BELOW THIS LINE
-- ============================================================

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local TAG = "DraggableBoxGui" -- must match ButtonGui / ToggleGui / HoldGui
local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")

-- Every GUI made by ButtonGui / ToggleGui / HoldGui, wherever it lives
local function collectGuis()
	local list, seen = {}, {}
	local function add(inst)
		if inst:IsA("ScreenGui") and not seen[inst] then
			seen[inst] = true
			list[#list + 1] = inst
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(TAG)) do add(inst) end

	local function scan(container)
		if not container then return end
		local ok, children = pcall(function() return container:GetChildren() end)
		if not ok then return end
		for _, child in ipairs(children) do
			if child:IsA("ScreenGui") and child:GetAttribute(TAG) then add(child) end
		end
	end
	scan(playerGui)
	pcall(function() scan(game:GetService("CoreGui")) end)
	if gethui then pcall(function() scan(gethui()) end) end
	return list
end

local FADE_TIME = 0.12
local SHRINK_TIME = 0.15

local function fade(obj, time, props, style, direction)
	TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	):Play()
end

-- Same quick shrink + fade as DestroyAllGuis
local function remove(gui)
	local scale = gui:FindFirstChild("PopScale", true)
	if not scale then
		gui:Destroy()
		return
	end

	fade(scale, SHRINK_TIME, { Scale = 0.75 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("UIStroke") then
			fade(d, FADE_TIME, { Transparency = 1 })
		elseif d:IsA("GuiObject") then
			fade(d, FADE_TIME, { BackgroundTransparency = 1 })
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				fade(d, FADE_TIME, { TextTransparency = 1 })
			elseif d:IsA("ImageLabel") then
				fade(d, FADE_TIME, { ImageTransparency = 1 })
			elseif d:IsA("CanvasGroup") then
				fade(d, FADE_TIME, { GroupTransparency = 1 })
			end
		end
	end
	task.delay(SHRINK_TIME + 0.02, function()
		if gui.Parent then gui:Destroy() end
	end)
end

local removed = 0
for _, gui in ipairs(collectGuis()) do
	if gui:GetAttribute("Flag") == FLAG then
		removed += 1
		remove(gui)
	end
end

if removed == 0 then
	warn('No button, toggle or hold button with the flag "' .. tostring(FLAG) .. '" was found.')
end




