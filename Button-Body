			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(half + ICON_R * math.cos(angle), half + ICON_R * math.sin(angle)),
			Size = UDim2.fromOffset(ICON_THICK, ICON_THICK),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			ZIndex = 5,
		}, iconGroup)
